package it

import (
	"github.com/invopop/gobl.html/components/t"
	"github.com/invopop/gobl.html/internal"
)

// SDITitleType renders the title of a document sent through SDI from its
// document type (TipoDocumento), so that the PDF names the same document SDI
// received. The title of a self-billed TD17, for example, would otherwise be
// a plain "Fattura". Falls through to the default title when the document has
// no SDI document type.
templ SDITitleType(doc internal.Document) {
	if lbl := sdiTitleLabel(ctx, doc); lbl != "" {
		{ lbl }
	}
}

// CorrectionBadge marks a negative SDI document that corrects an earlier one
// of the same type, such as a TD17 that reverses part of a purchase. These
// documents keep their document type title, so the badge is what tells the
// reader they reduce an earlier one.
templ CorrectionBadge(doc internal.Document) {
	if isSDICorrection(doc) {
		<span class="correction">
			@t.T("regimes.it.correction")
		</span>
	}
}
