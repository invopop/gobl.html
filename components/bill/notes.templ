package bill

import (
	"bytes"
	"context"
	"fmt"

	"github.com/invopop/gobl.html/components/t"
	"github.com/invopop/gobl.html/components/utils"
	"github.com/invopop/gobl.html/display"
	"github.com/invopop/gobl.html/internal"
	"github.com/invopop/gobl/bill"
	"github.com/invopop/gobl/org"
	"github.com/invopop/gobl/tax"
	"github.com/yuin/goldmark"
	"github.com/yuin/goldmark/extension"
	"github.com/yuin/goldmark/renderer/html"
)

var markdown goldmark.Markdown

func init() {
	// prepare the markdown renderer
	markdown = goldmark.New(
		goldmark.WithExtensions(
			extension.NewLinkify(),
		),
		goldmark.WithRendererOptions(
			// NOTE: Please remove this!
			html.WithUnsafe(),
		),
	)
}

templ notes(notes []*org.Note) {
	@notesSection(nil, notes)
}

// notesSection renders the notes of a document at the "notes" anchor: the
// fixed notes always, the regular notes where a snippet can replace them.
// An invoice's tax notes are fixed, as they carry the regime's legal
// mentions. Snippets before and after the anchor sit outside the section,
// so they stay when WithHide hides it.
templ notesSection(fixed, notes []*org.Note) {
	@utils.Before(display.KeyNotes)
	if len(fixed) > 0 || showNotes(ctx, notes) {
		<section class="notes">
			@t.Scope(".notes") {
				<h2>
					@t.T(".title")
				</h2>
				for _, n := range fixed {
					@note(n)
				}
				@utils.Replaceable(display.KeyNotes) {
					for _, n := range notes {
						@note(n)
					}
				}
			}
		</section>
	}
	@utils.After(display.KeyNotes)
}

// showNotes determines if the regular notes, or a snippet replacing them,
// give the section something to show.
func showNotes(ctx context.Context, notes []*org.Note) bool {
	_, replaced := internal.Snippets(ctx).Replacement(display.KeyNotes)
	return len(notes) > 0 || replaced
}

templ lineNotes(notes []*org.Note) {
	if len(notes) > 0 {
		<span class="subline">
			for _, n := range notes {
				@note(n)
			}
		</span>
	}
}

templ note(note *org.Note) {
	<div class="note">
		@templ.Raw(renderNote(note))
	</div>
}

// invoiceTaxNotes converts the invoice's tax notes to org notes (with bold
// category prefix).
func invoiceTaxNotes(ctx context.Context, inv *bill.Invoice) []*org.Note {
	var result []*org.Note
	if inv.Tax != nil {
		r := inv.RegimeDef()
		for _, tn := range inv.Tax.Notes {
			result = append(result, &org.Note{
				Text: renderTaxNoteText(ctx, r, tn),
			})
		}
	}
	return result
}

// renderTaxNoteText returns formatted markdown text for a tax note,
// with a bold category prefix when available.
func renderTaxNoteText(ctx context.Context, r *tax.RegimeDef, n *tax.Note) string {
	txt := n.Text
	prefix := ""
	if n.Category != "" {
		if cd := r.CategoryDef(n.Category); cd != nil {
			prefix = cd.Name.In(t.Lang(ctx))
		} else {
			prefix = n.Category.String()
		}
	}
	if prefix != "" {
		txt = fmt.Sprintf("%s &middot; %s", prefix, txt)
	}
	return txt
}

func renderNote(note *org.Note) string {
	txt := note.Text
	if note.Code != "" {
		txt = fmt.Sprintf("`%s` &middot; %s", note.Code, txt)
	}
	buf := new(bytes.Buffer)
	if err := markdown.Convert([]byte(txt), buf); err != nil {
		return fmt.Sprintf("!(ERR %v)", err.Error())
	}
	return buf.String()
}

func registrationCapital(ctx context.Context, reg *org.Registration) string {
	if reg.Capital != nil {
		if reg.Currency != "" {
			return t.LocalizeCurrency(ctx, *reg.Capital, reg.Currency)
		}
		return t.LocalizeMoney(ctx, *reg.Capital)
	}
	return ""
}
