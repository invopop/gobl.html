package bill

import (
	"bytes"
	"context"
	"fmt"

	"github.com/invopop/gobl.html/components/t"
	"github.com/invopop/gobl.html/components/utils"
	"github.com/invopop/gobl.html/display"
	"github.com/invopop/gobl.html/internal"
	"github.com/invopop/gobl/bill"
	"github.com/invopop/gobl/org"
	"github.com/invopop/gobl/tax"
	"github.com/yuin/goldmark"
	"github.com/yuin/goldmark/extension"
	"github.com/yuin/goldmark/renderer/html"
)

var markdown goldmark.Markdown

func init() {
	// prepare the markdown renderer
	markdown = goldmark.New(
		goldmark.WithExtensions(
			extension.NewLinkify(),
		),
		goldmark.WithRendererOptions(
			// NOTE: Please remove this!
			html.WithUnsafe(),
		),
	)
}

templ notes(notes []*org.Note) {
	if len(notes) > 0 {
		<section class="notes">
			@t.Scope(".notes") {
				<h2>
					@t.T(".title")
				</h2>
				for _, n := range notes {
					@note(n)
				}
			}
		</section>
	}
}

// lineNotes renders the notes of a line, unless hidden by the display options
// alongside the rest of the item notes. Custom snippets for the item notes
// are rendered with the line references instead.
templ lineNotes(notes []*org.Note) {
	if len(notes) > 0 && !internal.Display(ctx).Suppressed(display.KeyLinesItemNotes) {
		<span class="subline">
			for _, n := range notes {
				@note(n)
			}
		</span>
	}
}

templ note(note *org.Note) {
	<div class="note">
		@templ.Raw(renderNote(note))
	</div>
}

// invoiceNotesSection renders the invoice's tax notes, which are always
// shown, followed by the regular notes, which may be hidden or replaced
// using the display options.
templ invoiceNotesSection(inv *bill.Invoice) {
	{{ taxNotes := invoiceTaxNotes(ctx, inv) }}
	if len(taxNotes) > 0 || showGeneralNotes(ctx, inv) {
		<section class="notes">
			@t.Scope(".notes") {
				<h2>
					@t.T(".title")
				</h2>
				for _, n := range taxNotes {
					@note(n)
				}
				@utils.Section(display.KeyNotesGeneral) {
					for _, n := range inv.Notes {
						@note(n)
					}
				}
			}
		</section>
	}
}

// invoiceTaxNotes converts tax notes to org notes (with bold category prefix).
func invoiceTaxNotes(ctx context.Context, inv *bill.Invoice) []*org.Note {
	var result []*org.Note
	if inv.Tax != nil {
		r := inv.RegimeDef()
		for _, tn := range inv.Tax.Notes {
			result = append(result, &org.Note{
				Text: renderTaxNoteText(ctx, r, tn),
			})
		}
	}
	return result
}

// showGeneralNotes determines if the invoice's regular notes, or snippets
// placed at their anchor, should be rendered.
func showGeneralNotes(ctx context.Context, inv *bill.Invoice) bool {
	d := internal.Display(ctx)
	if d.HasSnippets(display.KeyNotesGeneral) {
		return true
	}
	return len(inv.Notes) > 0 && !d.Hidden(display.KeyNotesGeneral)
}

// renderTaxNoteText returns formatted markdown text for a tax note,
// with a bold category prefix when available.
func renderTaxNoteText(ctx context.Context, r *tax.RegimeDef, n *tax.Note) string {
	txt := n.Text
	prefix := ""
	if n.Category != "" {
		if cd := r.CategoryDef(n.Category); cd != nil {
			prefix = cd.Name.In(t.Lang(ctx))
		} else {
			prefix = n.Category.String()
		}
	}
	if prefix != "" {
		txt = fmt.Sprintf("%s &middot; %s", prefix, txt)
	}
	return txt
}

func renderNote(note *org.Note) string {
	txt := note.Text
	if note.Code != "" {
		txt = fmt.Sprintf("`%s` &middot; %s", note.Code, txt)
	}
	buf := new(bytes.Buffer)
	if err := markdown.Convert([]byte(txt), buf); err != nil {
		return fmt.Sprintf("!(ERR %v)", err.Error())
	}
	return buf.String()
}

func registrationCapital(ctx context.Context, reg *org.Registration) string {
	if reg.Capital != nil {
		if reg.Currency != "" {
			return t.LocalizeCurrency(ctx, *reg.Capital, reg.Currency)
		}
		return t.LocalizeMoney(ctx, *reg.Capital)
	}
	return ""
}
