package bill

import (
	"context"
	"fmt"
	"github.com/invopop/ctxi18n/i18n"
	"github.com/invopop/gobl.html/components/regimes/pt"
	"github.com/invopop/gobl.html/components/t"
	"github.com/invopop/gobl/bill"
	"github.com/invopop/gobl/currency"
	"github.com/invopop/gobl/pay"
)

templ totals(inv *bill.Invoice, totals *bill.Totals) {
	<section class="totals">
		@t.Scope(".totals") {
			<h2>
				@t.T(".title")
			</h2>
			<table>
				<tbody>
					@totalsBaseRows(inv, totals)
					@totalsPayableRows(inv, totals)
					@totalsDueRows(inv, totals)
				</tbody>
			</table>
		}
	</section>
}

templ totalsBaseRows(inv *bill.Invoice, totals *bill.Totals) {
	<tr class="sum strong">
		<th>
			@t.T(".sum")
		</th>
		<td>
			@t.LM(totals.Sum)
		</td>
	</tr>
	if totals.Discount != nil {
		<tr class="discount">
			<th>
				@t.T(".discount")
			</th>
			<td>
				@t.LM(*totals.Discount)
			</td>
		</tr>
	}
	if totals.Charge != nil {
		<tr class="charges">
			<th>
				@t.T(".charge")
			</th>
			<td>
				@t.LM(*totals.Charge)
			</td>
		</tr>
	}
	if totals.TaxIncluded != nil {
		<tr>
			<th>
				@t.T(".prices_include", i18n.M{"tax": totalPricesIncludeTax(ctx, inv)})
			</th>
			<td>
				@t.LM(*totals.TaxIncluded)
			</td>
		</tr>
	}
	if !totals.Total.Equals(totals.Sum) {
		<tr class="total">
			<th>
				@t.T(".total")
			</th>
			<td>
				@t.LM(totals.Total)
			</td>
		</tr>
	}
	if totals.Taxes != nil && len(totals.Taxes.Categories) > 0 && (totals.TaxIncluded == nil || !totals.TaxIncluded.Equals(totals.Tax)) {
		<tr class="tax">
			<th>
				@t.T(".taxes")
			</th>
			<td>
				@t.LM(totals.Tax)
			</td>
		</tr>
	}
	if !totals.TotalWithTax.Equals(totals.Payable) {
		<tr class="total-with-tax strong">
			<th>
				@t.T(".total_with_tax")
			</th>
			<td>
				@t.LM(totals.TotalWithTax)
			</td>
		</tr>
	}
}

templ totalsPayableRows(inv *bill.Invoice, totals *bill.Totals) {
	if totals.RetainedTax != nil {
		<tr class="retained-tax">
			<th>
				@t.T(".retained_tax")
			</th>
			<td>
				@t.LM(totals.RetainedTax.Negate())
			</td>
		</tr>
	}
	if totals.Rounding != nil {
		<tr class="rounding">
			<th>
				@t.T(".rounding")
			</th>
			<td>
				@t.LM(*totals.Rounding)
			</td>
		</tr>
	}
	if label := payableLabel(inv, totals); label != "" {
		<tr class="payable strong">
			<th>
				@t.T(label)
			</th>
			<td>
				@t.LM(totals.Payable)
			</td>
		</tr>
	}
	for _, er := range totalExchangeRates(inv) {
		<tr class="exchange-rate">
			<th>
				@t.T(".exchange_rate", i18n.M{"to": er.To, "amount": t.Localize(ctx, er.Amount)})
			</th>
			<td>
				@t.LCD(er.Convert(totals.Payable), er.To)
			</td>
		</tr>
	}
}

templ totalsDueRows(inv *bill.Invoice, totals *bill.Totals) {
	if totals.Advances != nil {
		for _, adv := range inv.Payment.Advances {
			<tr class="advance">
				<th>
					{ advanceText(ctx, adv) }
				</th>
				<td>
					@t.LM(adv.Amount)
				</td>
			</tr>
		}
		if totals.Due != nil {
			<tr class="due strong">
				<th>
					@t.T(".due_sum")
				</th>
				<td>
					@t.LM(*totals.Due)
				</td>
			</tr>
		}
	}
}

func totalPricesIncludeTax(ctx context.Context, inv *bill.Invoice) string {
	if inv.Tax == nil || inv.Tax.PricesInclude == "" {
		return ""
	}
	r := inv.RegimeDef()
	category := r.CategoryDef(inv.Tax.PricesInclude)
	if category == nil {
		return inv.Tax.PricesInclude.String()
	}
	return category.Name.In(t.Lang(ctx))
}

// payableLabel names the payable total, which is only what's left to pay when
// nothing comes off it. With advances, what's left to pay is the amount due
// below them, so the payable is just the invoice's total. It returns an empty
// label when the row isn't worth showing.
func payableLabel(inv *bill.Invoice, totals *bill.Totals) string {
	switch {
	case inv.Type.In(bill.InvoiceTypeCreditNote):
		// Credit notes aren't necessarily payable.
		return ".total"
	case totals.Due == nil:
		return ".total_to_pay"
	case totals.TotalWithTax.Equals(totals.Payable):
		return ".total_with_tax"
	default:
		// Retained taxes or rounding already lead from the total with tax,
		// shown on its own row above, to the advances and the amount due.
		return ""
	}
}

func totalExchangeRates(inv *bill.Invoice) []*currency.ExchangeRate {
	list := make([]*currency.ExchangeRate, 0, len(inv.ExchangeRates))
	for _, er := range inv.ExchangeRates {
		if er.From == inv.Currency {
			list = append(list, er)
		}
	}
	return list
}

// advanceText builds the label of an advance row from its description, reference and date,
// falling back to a generic translated label when the advance has no description. Portuguese
// invoices also say how the advance was paid, which the AT expects to see on the document.
func advanceText(ctx context.Context, adv *pay.Record) string {
	txt := adv.Description
	if txt == "" {
		txt = i18n.T(ctx, ".advance")
	}
	if adv.Ref != "" {
		txt = fmt.Sprintf("%s (%s)", txt, adv.Ref)
	}
	if adv.Date != nil {
		// TODO: add date formatting
		txt = fmt.Sprintf("%s %s", adv.Date.String(), txt)
	}
	if means := pt.AdvanceMeans(ctx, adv); means != "" {
		txt = fmt.Sprintf("%s (%s)", txt, means)
	}
	return txt
}
