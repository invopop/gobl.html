package previewer

import (
	"strings"

	"github.com/invopop/gobl.html/internal/catalog"
	"github.com/invopop/icons"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
)

// Page renders the previewer. The catalog is embedded as JSON for the Alpine
// component in previewer.js, which filters the server-rendered rows and
// renders the selected example through the WebAssembly build.
templ Page(entries []catalog.Entry) {
	{{ groups := Groups(entries) }}
	@popui.App(props.App{
		Title:        "gobl.html previewer",
		FillViewport: true,
		Data:         "previewer()",
		Head:         pageStyle(),
		Scripts: []props.Script{
			{Src: "/wasm/wasm_exec.js"},
			{Src: "/previewer.js"},
		},
	}) {
		@templ.JSONScript("catalog", entries)
		@sidebar(groups)
		@popui.Header(props.Header{Title: search()}) {
			<span class="text-sm text-foreground-default-secondary tabular-nums whitespace-nowrap" x-text="countLabel()"></span>
			@popui.Select(props.Select{
				Class:      "w-44",
				Options:    LocaleOptions(),
				Attributes: templ.Attributes{"x-model": "params.locale", "title": "Rendering locale; default keeps the example's own"},
			})
			@popui.Select(props.Select{
				Class: "w-36",
				Options: []props.SelectOption{
					{Value: "", Label: "A4"},
					{Value: "Letter", Label: "Letter"},
					{Value: "DIN5008", Label: "DIN 5008"},
				},
				Attributes: templ.Attributes{"x-model": "params.layout", "@change": "layoutChanged()", "title": "Page layout"},
			})
			@popui.Select(props.Select{
				Class: "w-28",
				Options: []props.SelectOption{
					{Value: "fit", Label: "Fit"},
					{Value: "0.5", Label: "50%"},
					{Value: "0.75", Label: "75%"},
					{Value: "1", Label: "100%"},
					{Value: "1.5", Label: "150%"},
				},
				Attributes: templ.Attributes{"x-model": "zoom", "@change": "fitPaper()", "title": "Zoom"},
			})
			@popui.Button(props.Button{
				Variant:       props.ButtonVariantSecondary,
				Size:          props.ButtonSizeLarge,
				Class:         "min-h-8.5", // the selects' height
				PopoverTarget: "options",
			}) {
				@icons.Sliders()
				Options
			}
			@popui.Button(props.Button{
				Variant:    props.ButtonVariantSecondary,
				Size:       props.ButtonSizeIconLarge,
				Attributes: templ.Attributes{"@click": "runBenchmark()", ":disabled": "!ready || running", "title": "Benchmark: render the listed examples through WASM and natively side by side"},
			}) {
				@icons.Dashboard()
			}
		}
		@popui.Main(props.Main{Class: "flex-row gap-0 overflow-hidden justify-start"}) {
			@list(entries)
			@preview(entries)
		}
		@options()
	}
}

// pageStyle holds the styles for the parts PopUI has no component for: the
// paper sheet, its overlays and the selected row. Colors come from the
// PopUI tokens.
templ pageStyle() {
	<style>
		[data-row][data-selected] { background: var(--color-background-selected-default); }
		[data-row]:hover { background: var(--color-background-default-secondary); }
		[data-row][data-selected]:hover { background: var(--color-background-selected-default); }
		.pv-canvas { display: flex; justify-content: center; align-items: flex-start; gap: 28px; padding: 28px 28px 56px; min-height: 100%; }
		.pv-stack { display: flex; flex-direction: column; align-items: center; gap: 8px; }
		.pv-caption { font-size: 12px; font-weight: 500; color: var(--color-foreground-default-secondary); }
		.pv-paper { position: relative; flex: none; background: #fff; }
		.pv-sheet { position: absolute; top: 0; left: 0; transform-origin: 0 0; }
		.pv-sheet iframe { display: block; border: 0; background: #fff; }
		.pv-overlay { position: absolute; inset: 0; pointer-events: none; }
		.pv-break { position: absolute; left: 0; right: 0; border-top: 1px dashed var(--color-border-default-secondary); }
		.pv-break span { position: absolute; right: 0; top: -1px; transform: translateY(-100%); padding: 1px 6px; font-size: 10px; color: var(--color-foreground-default-tertiary); background: rgba(255,255,255,.85); }
		.pv-window { position: absolute; border: 1.5px dashed var(--color-border-selected-bold); background: var(--color-background-selected-default); border-radius: 1mm; }
		.pv-window span { position: absolute; left: 0; top: -1.5px; transform: translateY(-100%); font-size: 10px; color: var(--color-foreground-selected); white-space: nowrap; }
		.pv-fold { position: absolute; left: 0; width: 6mm; border-top: 1px solid var(--color-foreground-default-secondary); }
		.pv-fold.punch { width: 9mm; }
		.pv-edge { position: absolute; inset: 0; margin: 10mm 10mm 20mm; border: 1px dashed var(--color-border-critical-bold); opacity: .5; }
		kbd { padding: 0 4px; border: 1px solid var(--color-border); border-bottom-width: 2px; border-radius: 3px; font-size: 10px; color: var(--color-foreground-default-tertiary); }
	</style>
}

templ search() {
	@popui.Input(props.Input{
		Class:       "w-80",
		Size:        props.InputSizeSmall,
		Placeholder: "Search examples…  /",
		Icon:        icons.Search(),
		Attributes:  templ.Attributes{"x-model": "q", "x-ref": "q", "autocomplete": "off"},
	})
}

// sidebar offers one dropdown per facet group. Each is a single choice
// whose first entry ("All …") clears it; Alpine keeps the counts in step
// with the other groups, the groups below the country only list what its
// examples have, and the addon group only shows when there is a choice.
templ sidebar(groups []Group) {
	@popui.Sidebar(props.Sidebar{Attributes: templ.Attributes{":style": "bench ? 'display:none' : ''"}}) {
		@popui.SidebarHeader() {
			@icons.Gobl()
			<span>gobl.html</span>
			<span class="text-foreground-default-tertiary font-normal">previewer</span>
		}
		@popui.SidebarContent() {
			<div class="flex flex-col gap-4 w-full px-2">
				for _, g := range groups {
					<div
						class="flex flex-col gap-1.5"
						if g.Key == "addon" {
							x-show="availableCount('addon') > 1"
							x-cloak
						}
					>
						@popui.Label(props.Label{ID: "facet-" + g.Key}) {
							{ g.Title }
						}
						<select
							id={ "facet-" + g.Key }
							class={ classes.FormField(), "pl-2 pr-9 truncate", classes.FormFieldState(false) }
							data-select-arrow
							:value={ "filters." + g.Key + "[0] ?? ''" }
							@change={ "choose('" + g.Key + "', $event.target.value)" }
						>
							<option value="" x-text={ "'" + g.All + " (' + count('" + g.Key + "', '') + ')'" }>{ g.All }</option>
							for _, f := range g.Facets {
								<option
									value={ f.Value }
									if g.Key != "country" {
										:hidden={ "!available('" + g.Key + "', '" + f.Value + "')" }
									}
									x-text={ "'" + f.Label + " (' + count('" + g.Key + "', '" + f.Value + "') + ')'" }
								>{ f.Label }</option>
							}
						</select>
					</div>
				}
			</div>
		}
		@popui.SidebarFooter() {
			@popui.Button(props.Button{
				Variant:    props.ButtonVariantTransparent,
				Size:       props.ButtonSizeSmall,
				Class:      "w-full",
				Attributes: templ.Attributes{":class": "hasFilters() ? '' : 'hidden'", "@click": "clearAll()"},
			}) {
				@icons.Reset()
				Clear filters
			}
		}
	}
}

// list renders every example once; Alpine shows the ones the filters keep.
templ list(entries []catalog.Entry) {
	<div class="w-80 shrink-0 border-r border-border bg-background overflow-y-auto flex flex-col" :style="bench ? 'display:none' : ''">
		<div class="sticky top-0 h-10 px-4 flex items-center gap-2 text-sm text-foreground-default-secondary border-b border-border bg-background shrink-0">
			<span x-text="visible.length + ' of ' + entries.length + ' examples'"></span>
			<a href="#" class="text-foreground-selected hover:underline whitespace-nowrap" x-show="hasFilters()" x-cloak @click.prevent="clearAll()">Remove filter</a>
			<span class="ml-auto"><kbd>↑</kbd> <kbd>↓</kbd></span>
		</div>
		<div :class="visible.length === 0 ? '' : 'hidden'" x-cloak>
			@popui.PageState(props.PageState{Title: "Nothing matches", Description: "Loosen the filters or clear the search."})
		</div>
		<ul>
			for _, e := range entries {
				<li>
					<a
						href="#"
						data-row
						data-file={ e.File }
						class="flex flex-col gap-0.5 px-4 py-1.5 border-b border-border cursor-pointer min-w-0"
						:class={ "isVisible('" + e.File + "') ? '' : 'hidden'" }
						:data-selected={ "selected === '" + e.File + "' ? '' : null" }
						@click.prevent={ "select('" + e.File + "')" }
						title={ e.File }
					>
						<span class="flex items-center gap-2 min-w-0 text-base">
							if e.Country != "" {
								@popui.Image(props.Image{Src: FlagURL(e.Country), Alt: strings.ToUpper(e.Country), Class: "w-3.5 h-2.5 rounded-[1.5px] shrink-0"})
							}
							<span class="truncate">{ Title(e.Title) }</span>
						</span>
						if e.Description != "" {
							<span class="truncate text-sm text-foreground-default-tertiary pl-[22px]">{ e.Description }</span>
						}
					</a>
				</li>
			}
		</ul>
	</div>
}

// Title capitalises the first letter of an example title.
func Title(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// preview holds the toolbar and the paper canvas. While a benchmark runs the
// canvas shows the browser and server renders side by side; once it finishes
// the main sheet shows the results laid out like a GOBL document.
templ preview(entries []catalog.Entry) {
	<div class="flex-1 min-w-0 flex flex-col">
		// The header: title, then file name and render stats, then the
		// description on the left; the links and the tags on the right. Every
		// example's file name and tags are rendered and the current one shown,
		// so the tags keep PopUI's styling.
		<div class="px-4 py-2 flex items-start gap-4 border-b border-border bg-background shrink-0">
			<div class="min-w-0 flex-1 flex flex-col gap-0.5">
				<span class="font-medium truncate" x-text="currentTitle()"></span>
				<span class="text-sm text-foreground-critical truncate" x-show="error" x-text="error"></span>
				for _, e := range entries {
					if e.Description != "" {
						<span class="text-sm text-foreground-default-secondary" :class={ "selected === '" + e.File + "' && !bench ? '' : 'hidden'" }>{ e.Description }</span>
					}
				}
			</div>
			<div class="shrink-0 flex flex-col items-end gap-1.5 max-w-[50%]">
				<span class="flex items-center gap-1">
					<template x-if="bench && !running">
						@popui.Button(props.Button{Variant: props.ButtonVariantTransparent, Size: props.ButtonSizeSmall, Attributes: templ.Attributes{"@click": "closeBenchmark()"}}) {
							@icons.ArrowLeft()
							Back to preview
						}
					</template>
					<template x-if="current && !bench">
						<span class="flex items-center gap-1">
							@popui.Button(props.Button{Variant: props.ButtonVariantTransparent, Size: props.ButtonSizeSmall, Href: "#", Target: "_blank", Attributes: templ.Attributes{":href": "serverURL(current.file, 'html')"}}) {
								HTML
							}
							@popui.Button(props.Button{Variant: props.ButtonVariantTransparent, Size: props.ButtonSizeSmall, Href: "#", Target: "_blank", Attributes: templ.Attributes{":href": "serverURL(current.file, 'pdf')"}}) {
								PDF
							}
							@popui.Button(props.Button{Variant: props.ButtonVariantTransparent, Size: props.ButtonSizeSmall, Href: "#", Target: "_blank", Attributes: templ.Attributes{":href": "'/api/examples/' + current.file"}}) {
								JSON
							}
						</span>
					</template>
				</span>
				for _, e := range entries {
					<span class="flex flex-wrap justify-end gap-1" :class={ "selected === '" + e.File + "' && !bench ? '' : 'hidden'" }>
						@popui.TagStatus(props.TagStatus{Label: KindLabel(e.Kind), Status: KindStatus(e.Kind)})
						for _, a := range e.Addons {
							@popui.TagStatus(props.TagStatus{Label: a, Status: "steelBlue"})
						}
						for _, t := range e.Tags {
							@popui.TagStatus(props.TagStatus{Label: t, Status: "grey"})
						}
					</span>
				}
			</div>
		</div>
		<div class="flex-1 min-w-0 overflow-auto bg-background-default-secondary" x-ref="canvas">
			<div class="pv-canvas">
				<div class="pv-stack">
					<div class="pv-caption" :style="running ? '' : 'display:none'">Browser · WASM</div>
					<div class="pv-paper shadow-xl" x-ref="paper">
						<div class="pv-sheet" x-ref="sheet">
							<iframe title="Preview" x-ref="frame" @load="fitPaper()"></iframe>
							<div class="pv-overlay" x-ref="overlay"></div>
						</div>
					</div>
				</div>
				<div class="pv-stack" :style="running ? '' : 'display:none'">
					<div class="pv-caption">Server · native</div>
					<div class="pv-paper shadow-xl" x-ref="paper2">
						<div class="pv-sheet" x-ref="sheet2">
							<iframe title="Server render" x-ref="frame2" @load="fitPaper()"></iframe>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// options is the popover with the rendering, paper and benchmark settings.
templ options() {
	@popui.Popover(props.Popover{ID: "options", Backdrop: true, Class: "w-[26rem]"}) {
		<div class="flex flex-col gap-5">
			@popui.TitleGroup(props.TitleGroup{Title: "Options", Description: "Rendering parameters are sent to the renderer; paper settings only affect the preview."})
			@popui.Fieldset(props.Fieldset{Legend: "Document", Variant: props.FieldsetVariantCard}) {
				<div class="grid grid-cols-2 gap-3">
					@popui.Input(props.Input{Label: "Date format", Placeholder: "%d/%m/%Y", Attributes: templ.Attributes{"x-model": "params.date_format"}})
					@popui.Input(props.Input{Label: "Label", Attributes: templ.Attributes{"x-model": "params.label"}})
					@popui.Input(props.Input{Label: "Watermark", Attributes: templ.Attributes{"x-model": "params.watermark"}})
					@popui.Input(props.Input{Label: "Hide", Placeholder: "notes,footer.branding", Attributes: templ.Attributes{"x-model": "params.hide"}})
				</div>
				@popui.OptionGroup() {
					@popui.Checkbox(props.Checkbox{Variant: props.CheckboxVariantSwitch, Name: "void", Label: "Void", Attributes: templ.Attributes{"x-model": "params.void"}})
					@popui.Checkbox(props.Checkbox{Variant: props.CheckboxVariantSwitch, Name: "sandbox", Label: "Sandbox", Attributes: templ.Attributes{"x-model": "params.sandbox"}})
					@popui.Checkbox(props.Checkbox{Variant: props.CheckboxVariantSwitch, Name: "adjustment", Label: "Adjustment mode", Description: "Render credit and debit notes as adjustments", Attributes: templ.Attributes{"x-model": "params.adjustment_mode"}})
				}
			}
			@popui.Fieldset(props.Fieldset{Legend: "Paper", Variant: props.FieldsetVariantCard}) {
				@popui.Select(props.Select{
					Label: "Envelope window",
					Options: []props.SelectOption{
						{Value: "", Label: "Off"},
						{Value: "A", Label: "DIN 5008 Form A"},
						{Value: "B", Label: "DIN 5008 Form B"},
					},
					Attributes: templ.Attributes{"x-model": "window", "@change": "fitPaper()"},
				})
				@popui.Checkbox(props.Checkbox{Variant: props.CheckboxVariantSwitch, Name: "margins", Label: "Show print margins", Attributes: templ.Attributes{"x-model": "margins", "@change": "fitPaper()"}})
			}
			@popui.Fieldset(props.Fieldset{Legend: "Benchmark", Variant: props.FieldsetVariantCard}) {
				@popui.Input(props.Input{Label: "Rounds", Type: "number", Attributes: templ.Attributes{"x-model.number": "rounds", "min": "1", "max": "20"}})
			}
			@popui.ButtonGroup(props.ButtonGroup{Align: props.ButtonGroupAlignRight}) {
				@popui.Button(props.Button{Variant: props.ButtonVariantSecondary, PopoverTarget: "options", PopoverTargetAction: "hide"}) {
					Done
				}
			}
		</div>
	}
}
